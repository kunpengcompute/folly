+            static_cast<UrmaAsyncSocket*>(ordered.socket.get())->getUrmaStats();
+        ordered.socket->writeChain(&ordered, fragments.move());
+        require(lastDataSges == UrmaInit::getConfig().max_send_sge,
+                "registered fragments did not use the full device SGE limit");
+        storage.clear(); // Local DMA pins must retain wrapped buffers until CQE.
+        spin([&] { return ordered.received == ordered.expected.size() &&
+                         ordered.completed == 1; });
+        const auto after =
+            static_cast<UrmaAsyncSocket*>(ordered.socket.get())->getUrmaStats();
+        require(after.directSendBytes - before.directSendBytes == ordered.expected.size() &&
+                    after.copiedSendBytes == before.copiedSendBytes,
+                "device-limit registered SEND copied its payload");
+      }
+
+      stage = "registered SEND chain exceeds one WR SGE count";
+      ordered.expected.clear();
+      ordered.received = ordered.completed = 0;
+      IOBufQueue chain;
+      for (uint32_t i = 0; i < UrmaInit::getConfig().max_send_sge; ++i) {
+        std::string part(100, char('a' + i));
+        ordered.expected += part;
+        chain.append(IOBuf::copyBuffer(part));
+      }
+      const auto sendStatsBefore =
+          static_cast<UrmaAsyncSocket*>(ordered.socket.get())->getUrmaStats();
+      ordered.socket->writeChain(&ordered, chain.move());
+      spin([&] { return ordered.received == ordered.expected.size() && ordered.completed == 1; });
+      const auto sendStats =
+          static_cast<UrmaAsyncSocket*>(ordered.socket.get())->getUrmaStats();
+      require(
+          sendStats.copiedSendBytes - sendStatsBefore.copiedSendBytes == ordered.expected.size() &&
+              sendStats.directSendBytes == sendStatsBefore.directSendBytes,
+          "fragmented SEND must copy-coalesce instead of splitting at the SGE limit");
+
+      stage = "single registered SEND uses exclusive headroom";
+      ordered.expected.assign(1000, 'h');
+      ordered.received = ordered.completed = 0;
+      auto single = IOBuf::create(1024);
+      single->advance(urma_detail::kHeaderSize);
+      std::memcpy(single->writableData(), ordered.expected.data(), 1000);
+      single->append(1000);
+      const auto directBefore = static_cast<UrmaAsyncSocket*>(ordered.socket.get())->getUrmaStats();
+      ordered.socket->writeChain(&ordered, std::move(single));
+      require(lastDataSges == 1, "exclusive SEND headroom did not remove the header SGE");
+      spin([&] { return ordered.received == 1000 && ordered.completed == 1; });
+      require(static_cast<UrmaAsyncSocket*>(ordered.socket.get())->getUrmaStats().directSendBytes
+                  == directBefore.directSendBytes + 1000, "in-place SEND copied payload");
+
+      stage = "owned SEND survives close until late TX completion";
+      {
+        const auto accepted = acceptor.connections.size();
+        Echo pending(UrmaAsyncSocket::newSocket(&evb, address), false);
+        pending.allowWriteError = pending.allowReadError = true;
+        spin([&] { return acceptor.connections.size() == accepted + 1 &&
+            static_cast<UrmaAsyncSocket*>(pending.socket.get())->isUrmaReady(); });
+        auto source = UrmaInit::createPoolBuffer(1024);
+        require(bool(source), "owned SEND source allocation");
+        source->advance(urma_detail::kHeaderSize);
+        source->append(1000);
+        std::memset(source->writableData(), 's', 1000);
+        auto* addressInFlight = source->data();
+        pending.socket->writeChain(&pending, std::move(source));
+        Completions late;
+        for (auto& q : ready)
+          for (auto it = q.second.begin(); it != q.second.end();)
+            if (!it->flag.bs.s_r && it->user_ctx == lastCompletionContext) {
+              late.emplace_back(q.first, *it);
+              it = q.second.erase(it);
+            } else ++it;
+        require(late.size() == 1 && !pending.completed, "SEND completed before held CQE");
+        pending.socket->closeNow();
+        acceptor.connections.back()->socket->closeNow();
+        owner.poll();
+        require(!pending.completed && pending.writeErrors == 1 &&
+                    bool(UrmaInit::lookupSegment(addressInFlight, 1000)),
+                "close released owned SEND before DMA completion");
+        for (size_t i = 0; i < 1000; ++i)
+          require(addressInFlight[i] == 's', "close overwrote in-flight SEND storage");
+        completeHeld(late);
+        owner.poll();
+        require(!UrmaInit::lookupSegment(addressInFlight, 1000) &&
+                    !pending.completed && pending.writeErrors == 1,
+                "late SEND completion retained its IOBuf or repeated the callback");
+        acceptor.connections.pop_back();
+      }
+
+      ordered.expected.assign(5000, 'r');
+      ordered.received = ordered.completed = 0;
+      stage = "reordered DATA";
+      reorderData = true;
+      static_cast<UrmaAsyncSocket*>(ordered.socket.get())
+          ->writeChainWithRecords(
+              &ordered, IOBuf::copyBuffer(ordered.expected), {2000, 3000});
+      spin([&] { return ordered.received == 5000 && ordered.completed == 1; });
+      require(
+          !reorderData && heldData.empty(),
+          "out-of-order DATA was not exercised");
+
+      // FREE before local PULL CQE must not finish the write; duplicate FREE
+      // must not consume a receive sequence or release a later READ source.
+      ordered.expected.assign(8192, 'v');
+      ordered.received = ordered.completed = 0;
+      ordered.retainRead = true;
+      stage = "FREE before PULL CQE";
+      holdPullCompletion = duplicateFree = true;
+      ordered.socket->write(
+          &ordered, ordered.expected.data(), ordered.expected.size());
+      spin([&] {
+        return ordered.received == 8192 && heldPullCompletions.size() == 1;
+      });
+      require(
+          ordered.completed == 0,
+          "FREE completed a write before its local PULL CQE");
+      stage = "released PULL CQEs";
+      holdPullCompletion = false;
+      completeHeldReverse(heldPullCompletions);
+      spin([&] { return ordered.completed == 1; });
+      for (int i = 0; i < 32; ++i)
+        evb.loopOnce(EVLOOP_NONBLOCK);
+      duplicateFree = false;
+      ordered.retainRead = false;
+      auto retained = std::move(ordered.retained);
+      stage = "retained READ destination";
+      ordered.expected.assign(8192, 'w');
+      ordered.received = ordered.completed = 0;
+      ordered.socket->write(
+          &ordered, ordered.expected.data(), ordered.expected.size());
+      spin([&] { return ordered.received == 8192 && ordered.completed == 1; });
+      require(
+          retained && retained->length() == 8192,
+          "READ IOBuf ownership missing");
+      for (size_t i = 0; i < retained->length(); ++i)
+        require(
+            retained->data()[i] == 'v',
+            "subsequent READ overwrote an application-held IOBuf");
+      // Last release on a different thread is allowed; owner allocation
+      // reclaims it.
+      std::thread consumer(
+          [data = std::move(retained)]() mutable { data.reset(); });
+      consumer.join();
+
+      // Resource pressure must leave a valid PULL queued, not fail the stream
+      // or start READ before its destination and active budget are available.
+      {
+        stage = "READ count wait";
+        auto pressure = holdReadSlots(owner);
+        ordered.expected.assign(8192, 'b');
+        ordered.received = ordered.completed = 0;
+        const auto readsBefore = owner.snapshot().reads;
+        ordered.socket->write(
+            &ordered, ordered.expected.data(), ordered.expected.size());
+        spin([&] { return owner.snapshot().waiting != 0; });
+        require(
+            ordered.socket->good() && !ordered.completed && !ordered.received &&
+                owner.snapshot().reads == readsBefore,
+            "READ budget pressure closed the stream or submitted READ");
+        pressure.clear();
+        spin(
+            [&] { return ordered.received == 8192 && ordered.completed == 1; });
+        for (int i = 0; i < 32; ++i)
+          evb.loopOnce(EVLOOP_NONBLOCK);
+        require(owner.snapshot().waiting == 0, "READ budget waiter leaked");
+      }
+
+      stage = "READ destination wait";
+      ordered.expected.assign(8192, 'm');
+      ordered.received = ordered.completed = 0;
+      const auto pullsBefore = checkedPulls;
+      const auto readsBefore = owner.snapshot().reads;
+      holdPullReceives = true;
+      ordered.socket->write(
+          &ordered, ordered.expected.data(), ordered.expected.size());
+      require(checkedPulls > pullsBefore, "source did not publish PULL");
+      spin([&] { return heldPullReceives.size() == 1 && !owner.snapshot().inflight; });
+      // Exhaust after TX completion, otherwise returning a TLS control block
+      // can itself supply the READ target and invalidate this pressure setup.
+      std::vector<UrmaInit::Buffer> pressure;
+      for (size_t bytes : {size_t(1024 * 1024), size_t(4096)}) {
+        for (auto buffer = UrmaInit::allocateBuffer(bytes); buffer.memory;
+             buffer = UrmaInit::allocateBuffer(bytes)) {
+          pressure.push_back(std::move(buffer));
+        }
+      }
+      holdPullReceives = false;
+      completeHeld(heldPullReceives);
+      spin([&] { return owner.snapshot().waiting != 0; });
+      require(
+          ordered.socket->good() && !ordered.completed && !ordered.received &&
+              owner.snapshot().reads == readsBefore,
+          "destination pressure closed the stream or submitted READ");
+      auto budget = holdReadSlots(owner);
+      budget.clear();
+      // No CQE is needed to wake a buffer returned by an application thread.
+      std::thread releaser(
+          [buffers = std::move(pressure)]() mutable { buffers.clear(); });
+      releaser.join();
+      spin([&] { return ordered.received == 8192 && ordered.completed == 1; });
+      for (int i = 0; i < 32; ++i)
+        evb.loopOnce(EVLOOP_NONBLOCK);
+      require(owner.snapshot().waiting == 0, "destination waiter leaked");
+
+      if (readError) {
+        stage = "READ failure must not skip an ordered record";
+        auto& failingSender = *clients[2];
+        auto& failingReceiver = *acceptor.connections[2];
+        failingSender.allowWriteError = failingSender.allowReadError = true;
+        failingReceiver.allowWriteError = failingReceiver.allowReadError = true;
+        failingReceiver.echo = false;
+        failingReceiver.expected.assign(3 * 8192, 'e');
+        holdReads = true;
+        for (int i = 0; i < 3; ++i)
+          failingSender.socket->write(
+              &failingSender, failingReceiver.expected.data() + i * 8192, 8192);
+        spin([&] { return heldReads.size() == 3; });
+        for (size_t i = heldReads.size(); i > 1; --i)
+          signalQueue(heldReads[i - 1].first, heldReads[i - 1].second);
+        // Later records are complete but cannot be delivered across the hole.
+        for (int i = 0; i < 32; ++i)
+          evb.loopOnce(EVLOOP_NONBLOCK);
+        require(
+            !failingReceiver.received, "later READ escaped ordered delivery");
+        auto failed = heldReads.front();
+        failed.second.status = URMA_CR_LOC_ACCESS_ERR;
+        heldReads.clear();
+        holdReads = false;
+        signalQueue(failed.first, failed.second);
+        spin([&] { return failingReceiver.readErrors == 1; });
+        require(
+            !failingReceiver.received && !failingReceiver.socket->good(),
+            "failed READ was skipped instead of terminating the stream");
+      }
+
+      stage = "paused and closing readers";
+      auto& paused = *clients.back();
+      auto& closingInCallback = *clients.front();
+      paused.expected = "delayed consumer";
+      paused.received = paused.completed = 0;
+      paused.socket->setReadCB(nullptr);
+      closingInCallback.expected.assign(8192, 'z');
+      closingInCallback.received = closingInCallback.completed = 0;
+      closingInCallback.closeOnRead = true;
+      closingInCallback.allowWriteError = true;
+      paused.socket->write(
+          &paused, paused.expected.data(), paused.expected.size());
+      closingInCallback.socket->write(
+          &closingInCallback,
+          closingInCallback.expected.data(),
+          closingInCallback.expected.size());
+      spin([&] {
+        return closingInCallback.received ==
+            closingInCallback.expected.size() &&
+            paused.completed == 1;
+      });
+      require(paused.received == 0, "paused reader was called");
+      paused.socket->setReadCB(&paused);
+      spin([&] { return paused.received == paused.expected.size(); });
+      clients.erase(clients.begin());
+      for (int i = 0; i < 32; ++i)
+        evb.loopOnce(EVLOOP_NONBLOCK);
+      stage = "surviving peer";
+      auto& survivor = *clients.back();
+      survivor.expected = "still alive";
+      survivor.received = survivor.completed = 0;
+      survivor.socket->write(
+          &survivor, survivor.expected.data(), survivor.expected.size());
+      spin([&] {
+        return survivor.received == survivor.expected.size() &&
+            survivor.completed == 1;
+      });
+      require(jfsCreated == count, "socket close recreated queues");
+      // Closing an published PULL must retain its source until the late FREE.
+      // The receiver consumes without echoing, so it can finish after close.
+      auto& closing = *clients.back();
+      auto& receiver = *acceptor.connections.back();
+      receiver.echo = false;
+      receiver.expected.assign(3 * 8192, 'q');
+      receiver.received = 0;
+      closing.expected = receiver.expected;
+      closing.allowWriteError = true;
+      receiver.allowReadError = true;
+      stage = "late FREE";
+      holdFree = true;
+      for (int i = 0; i < 3; ++i)
+        closing.socket->write(
+            &closing, closing.expected.data() + i * 8192, 8192);
+      spin([&] {
+        return receiver.received == receiver.expected.size() &&
+            heldFrees.size() == 3;
+      });
+      const auto retiredBeforeClosing = owner.snapshot().retired;
+      closing.socket->closeNow();
+      const auto retiredWithClosing = owner.snapshot().retired;
+      require(
+          retiredWithClosing == retiredBeforeClosing + 1,
+          "closed READ source was not quarantined");
+      holdFree = false;
+      signalQueue(heldFrees.back().first, heldFrees.back().second);
+      heldFrees.pop_back();
+      for (int i = 0; i < 32; ++i)
+        evb.loopOnce(EVLOOP_NONBLOCK);
+      require(
+          owner.snapshot().retired == retiredWithClosing,
+          "one late FREE released other unconfirmed READ sources");
+      completeHeldReverse(heldFrees);
+      spin([&] {
+        return owner.snapshot().retired + 1 == retiredWithClosing &&
+            receiver.received == receiver.expected.size() && receiver.readErrors == 1;
+      });
+      clients.clear();
+      acceptor.connections.clear();
+      server->stopAccepting();
+      server.reset();
+      UrmaIoContext::release(&evb);
+    }
+    UrmaInit::fini();
+    if (readError) {
+      // Run separately: an errored READ never sends FREE. The source must
+      // remain quarantined; a local CQE/close is not a remote DMA barrier.
+      require(
+          UrmaInit::isInitialized() && registrations &&
+              UrmaInit::pendingCleanupCount(),
+          "unconfirmed remote READ source was prematurely released");
+      std::cout
+          << "PASS failed ordered READ is not skipped; unconfirmed source retained\n";
+    } else {
+      require(
+          !UrmaInit::isInitialized() && !registrations &&
+              importsCreated == importsDeleted && segmentImports == segmentUnimports &&
+              jfsCreated == jfsDeleted && jfrCreated == jfrDeleted,
+          "final resource imbalance");
+      bufferPressureCases();
+      writeAdmissionCases();
+      elasticCases();
+      revocationCases();
+    }
+    std::cout
+        << "PASS shared owner rollback, full endpoint identity, SQ wakeups, "
+           "direct completion reuse, CQ drain, READ chains with per-WR CQEs, "
+           "partial submission, reverse completion and DMA lifetime, "
+           "actual multi-socket SEND/READ "
+           "and close\n";
+  } catch (const std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/folly/io/async/urma/test/SegmentStateTest.cpp b/folly/io/async/urma/test/SegmentStateTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e6dc157ce4d42185cd82adc02fb7ae43b4e101b3
--- /dev/null
+++ b/folly/io/async/urma/test/SegmentStateTest.cpp
@@ -0,0 +1,105 @@
+/* Copyright (c) Huawei Technologies Co., Ltd. 2026. Licensed under Apache-2.0. */
+#include <folly/io/async/urma/UrmaProtocol.h>
+#include <folly/io/async/urma/UrmaSegmentState.h>
+#include <atomic>
+#include <iostream>
+#include <stdexcept>
+
+using namespace folly::urma_detail;
+namespace {
+std::atomic<bool> failUnimport{false};
+std::atomic<unsigned> unimports{0};
+void check(bool ok, const char* why) {
+  if (!ok) throw std::runtime_error(why);
+}
+}
+extern "C" urma_status_t urma_unimport_seg(urma_target_seg_t* segment) {
+  if (failUnimport) return URMA_EAGAIN;
+  delete segment;
+  ++unimports;
+  return URMA_SUCCESS;
+}
+int main() {
+  using Type = SegmentState::Type;
+  urma_seg_t initial{};
+  initial.ubva.eid.raw[0] = 7;
+  initial.ubva.uasid = 13;
+  initial.ubva.va = 4096;
+  initial.len = 4096;
+  std::array<uint8_t, 40> descriptor{};
+  std::memcpy(descriptor.data(), initial.ubva.eid.raw, 16);
+  putInteger(descriptor.data() + 16, initial.ubva.uasid, 4);
+  putInteger(descriptor.data() + 20, 16384, 8);
+  putInteger(descriptor.data() + 28, 8192, 8);
+  putInteger(descriptor.data() + 36, 19, 4);
+  unsigned imports = 0;
+  auto import = [&](const urma_seg_t& s) {
+    ++imports;
+    auto result = std::shared_ptr<ImportedSegment>(new ImportedSegment,
+        [](ImportedSegment* p) { cleanupOrDefer(std::unique_ptr<ImportedSegment>(p)); });
+    result->segment = new urma_target_seg_t{};
+    result->segment->seg = s;
+    return result;
+  };
+  for (bool close : {false, true}) {
+    SegmentState segments;
+    const uint64_t id = uint64_t(1) << 40;
+    auto receive = [&](Type type, uint64_t token, size_t size = 0) {
+      segments.receive(type, token, descriptor.data(), size, initial, import);
+    };
+    auto reject = [&](Type type, uint64_t token, size_t size) {
+      bool rejected = false;
+      try { receive(type, token, size); }
+      catch (const std::runtime_error&) { rejected = true; }
+      check(rejected, "invalid descriptor/control accepted");
+    };
+    reject(Type::Announce, id, 39);
+    descriptor[0] ^= 1;
+    reject(Type::Announce, id, 40);
+    descriptor[0] ^= 1;
+    for (uint64_t address : {uint64_t(0), initial.ubva.va, UINT64_MAX - 1}) {
+      putInteger(descriptor.data() + 20, address, 8);
+      reject(Type::Announce, id, 40);
+    }
+    putInteger(descriptor.data() + 20, 16384, 8);
+    receive(Type::Announce, id, 40);
+    check(segments.pending() && segments.pending()->type == Type::Ready &&
+              segments.pending()->id == id, "missing READY/full-width identity");
+    segments.pop();
+    auto heldRead = segments.find(16384, 8192);
+    check(heldRead && heldRead->segment->seg.token_id == 19 &&
+              !segments.find(16383, 1) && !segments.find(24575, 2),
+          "import range/descriptor changed");
+    const auto imported = imports;
+    receive(Type::Announce, id, 40);
+    segments.pop();
+    check(imports == imported, "duplicate announcement imported again");
+    reject(Type::Announce, id + 1, 40);
+    reject(Type::Ready, id, 0);
+    if (close) segments.close(true);
+    else receive(Type::Revoke, id);
+    check(!segments.find(16384, 1) && !segments.pending() && segments.waiting(),
+          "revocation acknowledged while a READ still holds the import");
+    failUnimport = true;
+    auto released = heldRead->released;
+    heldRead.reset();
+    segments.progress();
+    check(!released->load() && !segments.pending() && !segments.empty(),
+          "failed unimport acknowledged or discarded its cleanup responsibility");
+    failUnimport = false;
+    check(waitForCleanups(std::chrono::seconds(3)), "unimport did not recover");
+    segments.progress();
+    check(released->load() && segments.pending() &&
+              segments.pending()->type == Type::Revoked,
+          "missing REVOKED after successful hardware cleanup");
+    segments.pop();
+    receive(Type::Revoke, id);
+    check(segments.pending() && segments.pending()->type == Type::Revoked,
+          "duplicate REVOKE lost acknowledgement");
+    segments.pop();
+    reject(Type::Announce, id, 40);
+    check(segments.empty() && !segments.waiting(), "segment state retained after cleanup");
+  }
+  check(unimports == 2, "unexpected import cleanup count");
+  std::cout << "PASS segment validation, READ lifetime, revoke/close, failed unimport and replay\n";
+}
diff --git a/folly/io/async/urma/test/SocketContractTest.cpp b/folly/io/async/urma/test/SocketContractTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1c546da4286dffc385c6e107d126ae80a4368c6f
--- /dev/null
+++ b/folly/io/async/urma/test/SocketContractTest.cpp
@@ -0,0 +1,463 @@
+/* Copyright (c) Huawei Technologies Co., Ltd. 2026. Licensed under Apache-2.0.
+ */
+#include "TestUtil.h"
+#include <functional>
+#include <utility>
+using namespace folly;
+using namespace folly::urma_detail;
+using namespace folly::urma_test;
+using namespace std::chrono_literals;
+namespace {
+uint8_t pattern(size_t i, unsigned seed) {
+  return uint8_t((i * 31 + seed) % 251);
+}
+struct Endpoint : AsyncTransport::ReadCallback,
+                  AsyncTransport::WriteCallback,
+                  AsyncTransport::BufferCallback {
+  struct Completion : AsyncTransport::WriteCallback {
+    Endpoint& endpoint;
+    size_t index, calls{0};
+    Completion(Endpoint& e, size_t i) : endpoint(e), index(i) {}
+    void checkOrder() noexcept {
+      if (calls++ || index != endpoint.callbacks + endpoint.errors)
+        ++endpoint.errors;
+    }
+    void writeSuccess() noexcept override {
+      checkOrder();
+      endpoint.writeSuccess();
+    }
+    void writeErr(size_t n, const AsyncSocketException& e) noexcept override {
+      checkOrder();
+      endpoint.writeErr(n, e);
+    }
+  };
+  AsyncTransport::UniquePtr socket;
+  AsyncSocket* control{nullptr};  // accepted TCP control stream, owned by socket
+  std::deque<Completion> completions;
+  std::array<uint8_t, 16384> buffer{};
+  size_t sent{0}, received{0}, callbacks{0}, errors{0};
+  size_t eofs{0}, bytesAtEof{0}, readCallbacks{0};
+  unsigned seed{0};
+  bool movable{true}, closing{false};
+  std::function<void()> afterRead, afterWrite, onGetBuffer;
+  explicit Endpoint(AsyncTransport::UniquePtr s) : socket(std::move(s)) {
+    socket->setReadCB(this);
+    socket->setSendTimeout(5000);
+    transport().setBufferCallback(this);
+  }
+  ~Endpoint() {
+    transport().setBufferCallback(nullptr);
+    socket->setReadCB(nullptr);
+    socket->closeNow();
+  }
+  UrmaAsyncSocket& transport() {
+    return *static_cast<UrmaAsyncSocket*>(socket.get());
+  }
+  void writeSuccess() noexcept override {
+    ++callbacks;
+    if (auto action = std::exchange(afterWrite, {})) action();
+  }
+  void onEgressBuffered() override {
+    if (socket->getAllocatedBytesBuffered() < socket->getAppBytesBuffered())
+      ++errors;
+  }
+  void onEgressBufferCleared() override {
+    if (socket->getAllocatedBytesBuffered() || socket->getAppBytesBuffered())
+      ++errors;
+  }
+  void writeErr(size_t, const AsyncSocketException& e) noexcept override {
+    ++errors;
+    std::cerr << "write: " << e.what() << '\n';
+  }
+  void getReadBuffer(void** p, size_t* n) override {
+    if (auto action = std::exchange(onGetBuffer, {})) action();
+    *p = buffer.data();
+    *n = buffer.size();
+  }
+  bool isBufferMovable() noexcept override { return movable; }
+  void checkBytes(const uint8_t* p, size_t n) noexcept {
+    for (size_t i = 0; i < n; ++i)
+      if (p[i] != pattern(received + i, seed)) {
+        std::cerr << "payload/order mismatch at " << received + i << '\n';
+        ++errors;
+        break;
+      }
+    received += n;
+  }
+  void readDataAvailable(size_t n) noexcept override {
+    ++readCallbacks;
+    checkBytes(buffer.data(), n);
+    if (auto action = std::exchange(afterRead, {})) action();
+  }
+  void readBufferAvailable(std::unique_ptr<IOBuf> b) noexcept override {
+    ++readCallbacks;
+    auto* p = b.get();
+    do {
+      checkBytes(p->data(), p->length());
+      p = p->next();
+    } while (p != b.get());
+    if (auto action = std::exchange(afterRead, {})) action();
+  }
+  void readEOF() noexcept override {
+    ++eofs;
+    bytesAtEof = received;
+    if (!closing) ++errors;
+  }
+  void readErr(const AsyncSocketException& e) noexcept override {
+    ++errors;
+    std::cerr << "read: " << e.what() << '\n';
+  }
+  void send(size_t n, unsigned value) {
+    auto b = UrmaInit::createPoolBuffer(n);
+    require(bool(b), "test source allocation");
+    for (size_t i = 0; i < n; ++i)
+      b->writableData()[i] = pattern(sent + i, value);
+    b->append(n);
+    sent += n;
+    completions.emplace_back(*this, completions.size());
+    socket->writeChain(&completions.back(), std::move(b));
+  }
+};
+struct Listener : AsyncServerSocket::AcceptCallback {
+  EventBase& evb;
+  std::vector<std::unique_ptr<Endpoint>> peers;
+  explicit Listener(EventBase& e) : evb(e) {}
+  void connectionAccepted(NetworkSocket fd, const SocketAddress&,
+                          AcceptInfo) noexcept override {
+    try {
+      auto tcp = AsyncSocket::newSocket(&evb, fd);
+      auto* control = tcp.get();
+      auto p = std::make_unique<Endpoint>(
+          AsyncTransport::UniquePtr(new UrmaAsyncSocket(std::move(tcp))));
+      p->control = control;
+      p->seed = 19;
+      peers.push_back(std::move(p));
+    } catch (const std::exception& e) {
+      std::cerr << e.what() << '\n';
+    }
+  }
+  void acceptError(const std::exception& e) noexcept override {
+    std::cerr << e.what() << '\n';
+  }
+};
+template <class F>
+void pump(EventBase& evb, F predicate, const char* why) {
+  auto end = std::chrono::steady_clock::now() + 6s;
+  do {
+    evb.loopOnce(EVLOOP_NONBLOCK);
+    if (predicate()) return;
+    std::this_thread::sleep_for(100us);
+  } while (std::chrono::steady_clock::now() < end);
+  throw std::runtime_error(why);
+}
+void callbackReentry(EventBase& evb, Endpoint& client, Endpoint& server,
+                     const std::string& mode) {
+  // Let handshake completions settle before the single triggering write.
+  // No transport send timeout, reply timer, or extra traffic may rescue it.
+  client.socket->setSendTimeout(0);
+  server.socket->setSendTimeout(0);
+  const auto settled = std::chrono::steady_clock::now() + 50ms;
+  while (std::chrono::steady_clock::now() < settled) {
+    evb.loopOnce(EVLOOP_NONBLOCK);
+    std::this_thread::sleep_for(100us);
+  }
+  client.seed = 73;
+  server.seed = 19;
+  if (mode == "callback_write") {
+    client.afterWrite = [&] { client.send(32, 19); };
+    client.send(32, 19);
+    pump(evb, [&] { return client.callbacks == 2 && server.received == 64; },
+         "writeSuccess continuation stalled without unrelated traffic");
+  } else if (mode == "callback_read" || mode == "callback_read_movable") {
+    server.movable = mode == "callback_read_movable";
+    server.afterRead = [&] { server.send(32, 73); };
+    client.send(32, 19);
+    pump(evb, [&] { return client.received == 32 && server.callbacks == 1; },
+         "read callback reply stalled without unrelated traffic");
+  } else {
+    struct Reader : AsyncTransport::ReadCallback {
+      std::array<uint8_t, 64> buffer{};
+      size_t received{0}, errors{0};
+      void getReadBuffer(void** p, size_t* n) override {
+        *p = buffer.data();
+        *n = buffer.size();
+      }
+      void readDataAvailable(size_t n) noexcept override {
+        for (size_t i = 0; i < n; ++i)
+          if (buffer[i] != pattern(received + i, 19)) ++errors;
+        received += n;
+      }
+      void readEOF() noexcept override {}
+      void readErr(const AsyncSocketException&) noexcept override { ++errors; }
+    } replacement;
+    server.movable = false;
+    bool called = false;
+    server.onGetBuffer = [&] {
+      called = true;
+      if (mode == "callback_close") {
+        client.closing = server.closing = true;
+        server.socket->closeNow();
+      } else {
+        server.socket->setReadCB(
+            mode == "callback_replace" ? &replacement : nullptr);
+      }
+      // Endpoint::getReadBuffer still returns a valid buffer after reentry.
+    };
+    client.send(32, 19);
+    pump(evb, [&] { return called; }, "getReadBuffer was not invoked");
+    require(!server.received, "obsolete read callback received data");
+    if (mode != "callback_close") {
+      if (mode == "callback_unregister") {
+        for (int i = 0; i < 32; ++i) evb.loopOnce(EVLOOP_NONBLOCK);
+        require(!server.received && !replacement.received &&
+                    !server.socket->getReadCallback(),
+                "unregistered callback still received data");
+        server.socket->setReadCB(&replacement);
+      }
+      pump(evb, [&] { return replacement.received == 32; },
+           "replacement reader did not receive retained data");
+      require(!server.received && !replacement.errors,
+              "reader replacement lost bytes or notified old callback");
+    }
+    server.socket->setReadCB(nullptr);
+  }
+  require(!client.errors && !server.errors, "callback reentry failed");
+}
+
+void feedEnd(Endpoint& server, uint64_t sequence, bool eof = true) {
+  auto end = encodeEnd(sequence);
+  auto* cb = server.control->getReadCallback();
+  require(cb, "missing TCP control reader");
+  for (size_t offset : {size_t(0), size_t(3)}) {
+    void* p; size_t capacity;
+    cb->getReadBuffer(&p, &capacity);
+    const size_t n = offset ? end.size() - offset : 3;
+    require(capacity >= n, "TCP control buffer too small");
+    std::memcpy(p, end.data() + offset, n);
+    cb->readDataAvailable(n);
+  }
+  if (eof) cb->readEOF();
+}
+void timerContract(EventBase& evb, Endpoint& client, Endpoint& server) {
+  auto runFor = [&](auto duration) {
+    auto end = std::chrono::steady_clock::now() + duration;
+    do {
+      evb.loopOnce(EVLOOP_NONBLOCK);
+      std::this_thread::sleep_for(100us);
+    } while (std::chrono::steady_clock::now() < end);
+  };
+  // Warm timer reuse must preserve completion and then become fully idle.
+  for (int i = 0; i < 8; ++i) {
+    client.send(32, 19);
+    pump(evb, [&] { return client.callbacks == size_t(i + 1) &&
+        server.received == size_t(i + 1) * 32; }, "warm timer DATA progress");
+  }
+  runFor(40ms);
+  auto polls = cqPolls;
+  runFor(25ms);
+  require(cqPolls == polls, "idle transport kept polling after its final check");
+
+  // Reverse DATA must not postpone a stalled write's deadline. Hold the
+  // hardware completion beyond timeout and verify it cannot notify twice.
+  client.socket->setSendTimeout(25);
+  holdDataSends = true;
+  client.send(32, 19);
+  holdDataSends = false;
+  require(heldDataSends.size() == 1, "missing held DATA completion");
+  pump(evb, [&] { return server.received == 9 * 32; }, "stalled DATA receive");
+  const auto deadline = std::chrono::steady_clock::now() + 200ms;
+  while (!client.errors && std::chrono::steady_clock::now() < deadline) {
+    server.send(32, 73);
+    runFor(1ms);
+  }
+  require(client.transport().error() && client.callbacks == 8 &&
+              client.completions.back().calls == 1 && client.received,
+          "reverse DATA postponed timeout or completed the stalled write");
+  auto& owner = UrmaIoContext::get(&evb);
+  require(owner.snapshot().inflight, "timeout released a submitted DATA slot");
+  completeHeld(heldDataSends);
+  pump(evb, [&] { return !owner.snapshot().inflight; }, "late DATA completion");
+  require(client.callbacks == 8 && client.completions.back().calls == 1,
+          "late DATA completion notified a timed-out write twice");
+}
+void watchdogContract(EventBase& evb, Endpoint& client, Endpoint& server) {
+  // Settle the handshake so it cannot provide an unrelated poll timer.
+  const auto settled = std::chrono::steady_clock::now() + 40ms;
+  while (std::chrono::steady_clock::now() < settled) {
+    evb.loopOnce(EVLOOP_NONBLOCK);
+    std::this_thread::sleep_for(100us);
+  }
+  suppressEventSignals = true;
+  client.send(32, 19);
+  pump(evb, [&] { return client.callbacks == 1 && server.received == 32; },
+       "socket watchdog did not recover a lost CQ notification");
+  require(!client.errors && !server.errors, "lost event caused transport failure");
+
+  holdDataSends = true;
+  client.send(32, 19);
+  holdDataSends = false;
+  pump(evb, [&] { return server.received == 64; }, "held DATA receive");
+  require(heldDataSends.size() == 1, "missing post-close completion");
+  client.closing = server.closing = true;
+  client.socket->closeNow();
+  server.socket->closeNow();
+  auto& owner = UrmaIoContext::get(&evb);
+  require(owner.snapshot().inflight, "close released an outstanding DMA slot");
+  const auto calls = client.completions.back().calls;
+  // Both socket timers are gone and this CQE has no event notification.
+  completeHeld(heldDataSends);
+  pump(evb, [&] { return !owner.snapshot().inflight; },
+       "owner watchdog did not take over after socket close");
+  suppressEventSignals = false;
+  require(calls == 1 && client.completions.back().calls == calls,
+          "post-close completion duplicated the write callback");
+}
+void boundaryContract(EventBase& evb, Endpoint& client, Endpoint& server,
+                      const std::string& mode) {
+  client.closing = server.closing = true;
+  auto& owner = UrmaIoContext::get(&evb);
+  if (mode == "eof_missing_tail") {
+    feedEnd(server, 2);
+    const auto deadline = std::chrono::steady_clock::now() + 32s;
+    while (!server.errors && std::chrono::steady_clock::now() < deadline) {
+      evb.loopOnce(EVLOOP_NONBLOCK);
+      std::this_thread::sleep_for(1ms);
+    }
+    require(server.errors == 1 && !server.eofs,
+            "missing final DATA waited forever or produced a clean EOF");
+    return;
+  }
+  if (mode == "eof_truncated") {
+    server.control->getReadCallback()->readEOF();
+    require(server.errors == 1 && !server.eofs,
+            "unframed TCP EOF was reported as successful");
+    return;
+  }
+  if (mode == "eof_duplicate") {
+    feedEnd(server, 1, false);
+    feedEnd(server, 1, false);
+    require(server.errors == 1 && !server.eofs, "duplicate END was accepted");
+    return;
+  }
+  if (mode == "eof_read_budget" || mode == "eof_read_reject") {
+    std::vector<std::shared_ptr<void>> budget;
+    if (mode == "eof_read_budget") {
+      budget = holdReadSlots(owner);
+    } else blockReadPosts = true;
+    const auto pulls = checkedPulls;
+    const auto attempts = readPostCalls;
+    client.send(16384, 19);
+    pump(evb, [&] { return checkedPulls > pulls &&
+        (!budget.empty() || readPostCalls > attempts); }, "tail PULL did not wait");
+    feedEnd(server, 2);
+    require(!server.eofs && !server.errors && !server.received,
+            "EOF cancelled an unsubmitted tail READ");
+    budget.clear(); blockReadPosts = false;
+    owner.poll();
+    pump(evb, [&] { return server.eofs == 1 && client.callbacks == 1; },
+         "tail READ did not resume after EOF");
+    require(server.bytesAtEof == 16384 && !server.errors,
+            "tail READ/FREE/EOF ordering failed");
+    return;
+  }
+  holdDataCompletions = true;
+  server.movable = mode == "eof_movable" || mode == "delivery_batch" ||
+      mode == "delivery_event";
+  if (mode == "eof_paused") server.socket->setReadCB(nullptr);
+  for (size_t i = 0; i < 80; ++i) client.send(300, 19);
+  pump(evb, [&] { return client.callbacks == 80 && heldData.size() == 80; },
+       "tail DATA SEND completions");
+  client.socket->shutdownWrite();
+  pump(evb, [&] { return !server.control->getReadCallback(); },
+       "FIN did not precede held RX completions");
+  require(!server.eofs && !server.errors && !server.received,
+          "EOF overtook the held tail DATA");
+  holdDataCompletions = false;
+  if (mode == "delivery_batch" || mode == "delivery_event") completeHeld(heldData);
+  else completeHeldReverse(heldData);
+  if (mode == "delivery_event") {
+    bool rearmed = false;
+    onRearm = [&] {
+      require(server.received == 24000 && server.readCallbacks == 1,
+              "CQ event rearmed before delivering the whole ready prefix");
+      rearmed = true;
+    };
+    evb.loopOnce(EVLOOP_NONBLOCK);
+    require(rearmed, "completed DATA did not trigger the CQ event");
+  } else {
+    owner.poll();
+  }
+  if (mode == "delivery_close") {
+    require(!server.received && !server.eofs,
+            "application delivery ran inside CQ dispatch");
+    server.socket->closeNow();
+    for (int i = 0; i < 32; ++i) evb.loopOnce(EVLOOP_NONBLOCK);
+    require(!server.readCallbacks && server.eofs == 1 && !server.errors,
+            "queued delivery survived close or duplicated EOF");
+    return;
+  }
+  if (mode == "eof_paused") {
+    require(!server.eofs && !server.received, "paused reader lost its tail");
+    server.socket->setReadCB(&server);
+  }
+  pump(evb, [&] { return server.eofs == 1; }, "tail EOF never completed");
+  require(server.received == 24000 && server.bytesAtEof == 24000 &&
+              !server.errors && !client.errors,
+          "normal EOF lost or corrupted tail DATA");
+  if (mode == "delivery_batch" || mode == "delivery_event")
+    require(server.readCallbacks == 1,
+            "ready DATA prefix was delivered one CQE at a time");
+  // Receiving FIN must not close our own write side.
+  client.seed = 73;
+  server.send(32, 73);
+  pump(evb, [&] { return client.received == 32 && server.callbacks == 1; },
+       "peer half-close disabled the reverse write direction");
+}
+} // namespace
+int main(int argc, char** argv) {
+  if (argc != 2) return 2;
+  const std::string mode = argv[1];
+  try {
+    UrmaConfig c;
+    c.rx_depth = 128; c.rx_target = 96; c.tx_depth = 32;
+    c.max_pending_bytes = 2 * 1024 * 1024;
+    UrmaInit::init(c);
+    {
+      EventBase evb;
+      Listener accepted(evb);
+      SocketAddress address;
+      auto listener = listenOnLoopback(evb, accepted, address, 4);
+      {
+        Endpoint client(UrmaAsyncSocket::newSocket(&evb, address));
+        pump(evb, [&] { return !accepted.peers.empty() &&
+            client.transport().isUrmaReady() &&
+            accepted.peers[0]->transport().isUrmaReady(); }, "handshake");
+        auto& server = *accepted.peers[0];
+        client.seed = 73; server.seed = 19;
+        if (mode == "timer_progress")
+          timerContract(evb, client, server);
+        else if (mode == "timer_watchdog")
+          watchdogContract(evb, client, server);
+        else if (mode.rfind("callback_", 0) == 0)
+          callbackReentry(evb, client, server, mode);
+        else boundaryContract(evb, client, server, mode);
+        client.closing = server.closing = true;
+        client.socket->closeNow(); server.socket->closeNow();
+        accepted.peers.clear();
+      }
+      listener->stopAccepting();
+      listener.reset();
+      UrmaIoContext::release(&evb);
+    }
+    UrmaInit::fini();
+    require(urma_detail::waitForCleanups(2s) && !UrmaInit::isInitialized() &&
+                !registrations && jfsCreated == jfsDeleted &&
+                jfrCreated == jfrDeleted && importsCreated == importsDeleted,
+            "socket contract leaked owner resources");
+    std::cout << "PASS Socket." << mode << "\n";
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << "FAIL " << e.what() << '\n';
+    return 1;
+  }
+}

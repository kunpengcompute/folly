+/* Copyright (c) Huawei Technologies Co., Ltd. 2026. Licensed under Apache-2.0.
+ */
+#pragma once
+#ifdef FOLLY_HAVE_URMA
+#include <folly/SocketAddress.h>
+#include <folly/io/async/AsyncSocket.h>
+#include <folly/io/async/AsyncTransport.h>
+#include <folly/io/async/urma/UrmaRecordWriter.h>
+
+#include <memory>
+#include <vector>
+namespace folly {
+class UrmaAsyncSocket : public AsyncTransport, public UrmaRecordWriter {
+ public:
+  UrmaAsyncSocket(EventBase* evb, const SocketAddress& address);
+  UrmaAsyncSocket(EventBase* evb, int acceptedFd);
+  explicit UrmaAsyncSocket(AsyncSocket::UniquePtr acceptedSocket);
+  UrmaAsyncSocket(AsyncSocket::UniquePtr acceptedSocket,
+                 std::chrono::steady_clock::time_point handshakeStarted);
+  // Bytes already consumed by a protocol detector, up to one HELLO.
+  UrmaAsyncSocket(AsyncSocket::UniquePtr acceptedSocket,
+                  std::chrono::steady_clock::time_point handshakeStarted,
+                  std::vector<uint8_t> helloPrefix);
+  // Keep the legacy factory usable in a conditional with
+  // AsyncSocket::newSocket. Both branches can convert to the AsyncTransport
+  // owning pointer.
+  static AsyncTransport::UniquePtr newSocket(EventBase* evb,
+                                             const SocketAddress& address) {
+    return AsyncTransport::UniquePtr(new UrmaAsyncSocket(evb, address));
+  }
+  ~UrmaAsyncSocket() override;
+  void setReadCB(ReadCallback*) noexcept override;
+  ReadCallback* getReadCallback() const noexcept override;
+  void write(WriteCallback*, const void*, size_t,
+             WriteFlags = WriteFlags::NONE) noexcept override;
+  void writev(WriteCallback*, const iovec*, size_t,
+              WriteFlags = WriteFlags::NONE) noexcept override;
+  void writeChain(WriteCallback*, std::unique_ptr<IOBuf>&&,
+                  WriteFlags = WriteFlags::NONE) noexcept override;
+  // recordLengths describe complete serialized records BEFORE upper-layer
+  // batching, not IOBuf nodes. Their sum must equal the chain length. Adjacent
+  // small records can share SENDs; large records use READ independently. One
+  // callback still covers the entire write. Empty metadata means one record.
+  bool supportsUrmaRecords() const override { return true; }
+  void writeChainWithRecords(WriteCallback*, std::unique_ptr<IOBuf>&&,
+                             std::vector<size_t> recordLengths,
+                             WriteFlags = WriteFlags::NONE) noexcept override;
+  EventBase* getEventBase() const override;
+  void close() override;
+  void closeNow() override;
+  void shutdownWrite() override;
+  void shutdownWriteNow() override;
+  bool good() const override;
+  bool readable() const override;
+  bool writable() const override;
+  bool connecting() const override;
+  bool error() const override;
+  bool isDetachable() const override { return false; }
+  void attachEventBase(EventBase*) override;
+  void detachEventBase() override;
+  void setSendTimeout(uint32_t) override;
+  uint32_t getSendTimeout() const override;
+  // Called on the owning EventBase when queued bytes or retained capacity
+  // change. Registration is passive; the caller must keep the callback alive
+  // until it is unregistered. Idle registered caches are not pending egress.
+  void setBufferCallback(BufferCallback*);
+  size_t getAppBytesBuffered() const override;
+  size_t getRawBytesBuffered() const override;
+  size_t getAllocatedBytesBuffered() const override;
+  void getLocalAddress(SocketAddress*) const override;
+  void getPeerAddress(SocketAddress*) const override;
+  bool isEorTrackingEnabled() const override { return false; }
+  void setEorTracking(bool) override;
+  size_t getAppBytesWritten() const override;
+  size_t getRawBytesWritten() const override;
+  size_t getAppBytesReceived() const override;
+  size_t getRawBytesReceived() const override;
+  bool isUrmaReady() const;
+  struct Stats {
+    uint64_t sends, receives, reads;
+    uint64_t directReadBytes, copiedReadBytes, directSendBytes, copiedSendBytes;
+    uint64_t maxReadsInFlight;
+  };
+  // Owner-thread snapshot; counters survive close for per-connection tests.
+  Stats getUrmaStats() const;
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+}  // namespace folly
+#endif
diff --git a/folly/io/async/urma/UrmaCleanup.cpp b/folly/io/async/urma/UrmaCleanup.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e74f81d9ffef8e4b3d84990b5de33d8cac7dc9e8
--- /dev/null
+++ b/folly/io/async/urma/UrmaCleanup.cpp
@@ -0,0 +1,142 @@
+/* Copyright (c) Huawei Technologies Co., Ltd. 2026. Licensed under Apache-2.0.
+ */
+#include <folly/io/async/urma/UrmaCleanup.h>
+#ifdef FOLLY_HAVE_URMA
+#include <algorithm>
+#include <condition_variable>
+#include <cstdio>
+#include <exception>
+#include <mutex>
+#include <thread>
+#include <folly/logging/xlog.h>
+
+namespace folly::urma_detail {
+namespace {
+using Clock = std::chrono::steady_clock;
+class CleanupQueue {
+ public:
+  ~CleanupQueue() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stopping_ = true;
+      changed_.notify_all();
+    }
+    if (worker_.joinable()) worker_.join();
+    // An SDK failure is not evidence that DMA stopped. Never force-free the
+    // remaining tasks on library/process shutdown, either.
+    // Logger singletons may already have shut down by the time this static
+    // queue is destroyed. Keep the final retained-resource record observable.
+    for (auto* task = head_; task; task = task->next)
+      std::fprintf(stderr,
+                   "URMA cleanup retained at shutdown id=%llu stage=%s "
+                   "status=%d attempts=%llu\n",
+                   static_cast<unsigned long long>(task->id), task->stage,
+                   task->status,
+                   static_cast<unsigned long long>(task->attempts));
+  }
+  void add(CleanupTask* task) noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    task->id = ++nextId_;
+    task->attempts = 1; // The immediate teardown already failed.
+    task->retryAt = Clock::now() + std::chrono::milliseconds(10);
+    append(task);
+    ++pending_;
+    XLOG(ERR) << "URMA cleanup deferred id=" << task->id
+              << " stage=" << task->stage << " status=" << task->status
+              << " pending=" << pending_;
+    startWorker();
+    changed_.notify_all();
+  }
+  size_t pending() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return pending_;
+  }
+  bool wait(std::chrono::milliseconds timeout) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (pending_)
+      startWorker();  // Retry thread creation if an earlier attempt failed.
+    return changed_.wait_for(lock, timeout, [this] { return pending_ == 0; });
+  }
+
+ private:
+  void append(CleanupTask* task) noexcept {
+    task->next = head_;
+    head_ = task;
+  }
+  void startWorker() noexcept {
+    if (worker_.joinable() || stopping_) return;
+    try {
+      worker_ = std::thread([this] { run(); });
+    } catch (const std::exception& e) {
+      // Tasks remain tracked and retain their context references. A subsequent
+      // enqueue/fini can retry; never discard ownership on thread exhaustion.
+      XLOG(ERR) << "URMA cleanup worker could not start: " << e.what();
+    }
+  }
+  void run() noexcept {
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (!stopping_) {
+      if (!head_) {
+        changed_.wait(lock, [this] { return stopping_ || head_; });
+        continue;
+      }
+      auto** selected = &head_;
+      for (auto** p = &head_; *p; p = &(*p)->next)
+        if ((*p)->retryAt < (*selected)->retryAt) selected = p;
+      auto* task = *selected;
+      if (Clock::now() < task->retryAt) {
+        changed_.wait_until(lock, task->retryAt);
+        continue;
+      }
+      *selected = task->next;
+      task->next = nullptr;
+      lock.unlock();
+      ++task->attempts;
+      const bool done = task->tryCleanup();
+      if (done) {
+        XLOG(INFO) << "URMA cleanup recovered id=" << task->id
+                   << " attempts=" << task->attempts;
+        delete task;
+      } else {
+        // Log powers of two, and back off to at most one attempt per second.
+        // A permanently failing resource must not spin or flood the log.
+        if (!(task->attempts & (task->attempts - 1)))
+          XLOG(ERR) << "URMA cleanup still pending id=" << task->id
+                    << " stage=" << task->stage << " status=" << task->status
+                    << " attempts=" << task->attempts;
+        const auto delay = std::min<uint64_t>(
+            1000, uint64_t(10) << std::min<uint64_t>(task->attempts - 1, 7));
+        task->retryAt = Clock::now() + std::chrono::milliseconds(delay);
+      }
+      lock.lock();
+      if (done)
+        --pending_;
+      else
+        append(task);
+      changed_.notify_all();
+    }
+  }
+  std::mutex mutex_;
+  std::condition_variable changed_;
+  std::thread worker_;
+  CleanupTask* head_{nullptr};
+  size_t pending_{0};  // Includes the task currently being retried.
+  uint64_t nextId_{0};
+  bool stopping_{false};
+};
+CleanupQueue& queue() {
+  static CleanupQueue value;
+  return value;
+}
+}  // namespace
+
+void cleanupOrDefer(std::unique_ptr<CleanupTask> task) noexcept {
+  if (task && !task->tryCleanup())
+    queue().add(task.release());
+}
+size_t pendingCleanups() { return queue().pending(); }
+bool waitForCleanups(std::chrono::milliseconds timeout) {
+  return queue().wait(timeout);
+}
+}  // namespace folly::urma_detail
+#endif

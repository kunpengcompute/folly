+TEST(IoBufPool, ShareBlockReplacesUndersizedCurrentBlock) {
+  withFreshBlockCache([] {
+    gIoBufBlockSize.store(sizeof(IoBufBlock) + 1);
+    ASSERT_NE(nullptr, folly::detail::share_block(1));
+
+    gIoBufBlockSize.store(kDefaultBlockSize);
+    for (size_t i = 0; i < 3; ++i) {

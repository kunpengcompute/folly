+TEST(IoBufPool, BlockSizes) {
+  EXPECT_EQ(32u, sizeof(IoBufBlock));
+  EXPECT_EQ(8192u, kDefaultBlockSize);
+  EXPECT_EQ(256u, kMaxBlocksHardLimit);
+  EXPECT_EQ(8192u - 32u, kDefaultBlockSize - sizeof(IoBufBlock));
+}
